<HTA:APPLICATION
   APPLICATIONNAME="BurnNote"
   SCROLL="no"
   SINGLEINSTANCE="yes"
   WINDOWSTATE="normal"
   CAPTION="no"
   MAXIMIZEBUTTON="no"
   MINIMIZEBUTTON="no"
   BORDER="none"
   BORDERSTYLE="normal"
   SELECTION="no"
/>
<html>
<head>
<title>BurnNote — Iniciando</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    background: #000;
    color: #fff;
    font-family: 'Courier New', monospace;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    overflow: hidden;
    user-select: none;
  }
  .box {
    text-align: center;
    padding: 40px 60px;
    border: 2px solid #fff;
  }
  .title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }
  .sub {
    font-size: 11px;
    color: #555;
    letter-spacing: 0.15em;
    margin-bottom: 36px;
    text-transform: uppercase;
  }
  .bar-track {
    width: 240px;
    height: 2px;
    background: #222;
    margin: 0 auto 24px;
    position: relative;
    overflow: hidden;
  }
  .bar-fill {
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: #fff;
    animation: slide 1.4s linear infinite;
  }
  @keyframes slide {
    0%   { left: -100%; }
    100% { left: 100%; }
  }
  .status {
    font-size: 11px;
    color: #555;
    letter-spacing: 0.12em;
  }
</style>
</head>
<body>
<div class="box">
  <div class="title">BURN<span style="text-decoration:line-through">NOTE</span></div>
  <div class="sub">Zero-Knowledge &middot; Self-Hosted</div>
  <div class="bar-track"><div class="bar-fill"></div></div>
  <div class="status" id="statusText">INICIANDO SERVIDOR...</div>
</div>

<script language="VBScript">
Sub Window_OnLoad
  window.resizeTo 400, 260
  window.moveTo (screen.width - 400) \ 2, (screen.height - 260) \ 2
End Sub
</script>

<script language="VBScript">
Dim sentinelPath
Dim fso

' Build sentinel path relative to THIS HTA file location
' window.location.pathname gives /C:/Users/.../scripts/splash.hta
Dim htaPath
htaPath = window.location.pathname
' Remove leading slash on Windows paths
If Left(htaPath, 1) = "/" Then htaPath = Mid(htaPath, 2)
' Replace forward slashes with backslashes
htaPath = Join(Split(htaPath, "/"), "\")
' Go up one folder (scripts\ -> project root)
Set fso = CreateObject("Scripting.FileSystemObject")
Dim scriptsDir
scriptsDir = fso.GetParentFolderName(htaPath)
Dim projectDir
projectDir = fso.GetParentFolderName(scriptsDir)
sentinelPath = projectDir & "\.burnnote-ready"

Sub CheckSentinel
  If fso.FileExists(sentinelPath) Then
    On Error Resume Next
    fso.DeleteFile sentinelPath
    On Error GoTo 0
    window.close
  End If
End Sub
</script>

<script language="JavaScript">
  // Rotate status messages
  var states = [
    "INICIANDO SERVIDOR...",
    "ESTABLECIENDO TUNEL...",
    "ESPERANDO CONEXION...",
    "ABRIENDO BURNNOTE..."
  ];
  var idx = 0;
  setInterval(function() {
    idx = (idx + 1) % states.length;
    document.getElementById("statusText").innerText = states[idx];
  }, 1800);

  // Poll for sentinel file every 500ms (calls VBScript sub)
  setInterval(function() {
    CheckSentinel();
  }, 500);
</script>
</body>
</html>
