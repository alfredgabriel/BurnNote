# BurnNote Environment Configuration
# Copy this file to .env and adjust the settings as needed

NODE_ENV=production
PORT=3000
ORIGIN=http://localhost:3000

# SQLite Database path
DATABASE_PATH=./data/burnnote.db

# Rate Limiting
# Maximum requests per IP in the given window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Maximum note size in characters (default: 64KB)
MAX_NOTE_LENGTH=65536

# Cleanup interval for expired notes in milliseconds (default: 5 minutes)
CLEANUP_INTERVAL_MS=300000
